# Merged with GitHub's Python template from the repo's initial commit.
# Deliberately NOT carried over from that template: lib/, lib64/, bin/,
# share/, downloads/, parts/ — they are venv-layout entries, and here they
# would silently hide real source directories.

# Dependencies
node_modules/
.pnp/
.pnp.js

# Python
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
*.egg-info/
*.egg
.ipynb_checkpoints/

# Builds
dist/
build/
out/
sdist/
develop-eggs/
.eggs/
*.tsbuildinfo

# Native / mobile
mobile-app/android/app/build/
mobile-app/android/.gradle/
mobile-app/ios/Pods/
mobile-app/ios/build/
*.xcuserstate
.cxx/

# Datasets & model artifacts.
# The data/ tree is tracked (via .gitkeep) but its contents never are —
# see data/MANIFEST.yml for what belongs where and `scripts/check_data.py`
# to find out what is missing locally.
#
# This is the rule the Python template did not cover: the local tree is
# 9.5 GB, including a 1.5 GB pickle and 7.4 GB of GeoTIFFs.
data/**
!data/**/
!data/**/.gitkeep
!data/MANIFEST.yml
!data/README.md

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs & scratch
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
coverage/
.coverage
htmlcov/
tmp/

# Editors
.idea/
.vscode/

# Compiled test harness for the native bridge (rebuild with `make -C
# mobile-app/native/test`). The stub headers and sources beside it ARE tracked.
mobile-app/native/test/test_bridge

# Ultralytics writes these into the CURRENT WORKING DIRECTORY -- the repo root
# -- unless every call is given an explicit project/name. scripts/train_incident_yolo.py
# passes them; these rules catch any invocation that forgets.
/runs/
/yolo*.pt
/*.pt

# Compiled native test binaries. They are rebuilt by `make -C
# mobile-app/native/test`, and an architecture-specific a.out in the tree is
# worse than useless -- it is a binary nobody can review that shadows the
# source next to it.
mobile-app/native/test/test_bridge
mobile-app/native/test/test_dead_reckoning
*.o

# Compiled mission harness for the edge engine. Rebuilt on demand by
# backend/simulate_dark_zone_mission.mjs, which compiles it against
# mobile-app/native/ if it is absent. The .cpp beside it IS tracked; the
# architecture-specific binary is not.
backend/test/edge/dark_zone_drive

# Third-party agent tooling, installed per-machine rather than vendored.
.agents/
.claude/
skills-lock.json

# Artefacts written by dashboard/verify.mjs on every run: the throwaway Chrome
# profile it drives over CDP, and the screenshots it captures as evidence.
# Both are regenerated by `node verify.mjs`.
dashboard/cdp-profile/
dashboard/dash_*.png
