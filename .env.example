# ---------- Shared ----------
NODE_ENV=development

# ---------- PostGIS ----------
# Host ports are 5433/6380, not the 5432/6379 defaults: another local stack
# (demo_radar) already binds those. Inside the containers the services still
# use their standard ports.
PGHOST=localhost
PGPORT=5433
PGDATABASE=drishti
PGUSER=drishti
PGPASSWORD=drishti
DATABASE_URL=postgresql://drishti:drishti@localhost:5433/drishti

# ---------- Redis / BullMQ ----------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
SYNC_QUEUE_NAME=burst-sync
SYNC_QUEUE_CONCURRENCY=4

# ---------- Backend ----------
PORT=4000
SOCKET_PATH=/socket.io
JWT_SECRET=change-me-in-production
TELEMETRY_HZ=1

# ---------- AI services (FastAPI) ----------
# Paths are relative to the repo root and must match data/MANIFEST.yml.
# Run `python3 scripts/check_data.py` to see which of these exist locally.
AI_SERVICE_URL=http://localhost:8000

# Vision — incident verification (ML-05/ML-06)
YOLO_WEIGHTS=data/artifacts/vision/incident-yolov8n.pt
YOLO_DATASET=data/raw/vision/incident-yolo
YOLO_CONF_THRESHOLD=0.45
# 4 classes, not the 3 in the spec. Index order is load-bearing: it is what
# YOLO emits, and incidents.kind is derived from it. See MANIFEST.yml.
YOLO_CLASSES=NORMAL_TERRAIN,FLOODED_ROAD_OR_SUBMERGED,ACTIVE_LANDSLIDE_DEBRIS,DAMAGED_BRIDGE_INFRASTRUCTURE

# Landslide risk (ML-02/ML-04). The scaler must be the one fitted alongside
# the model — a mismatched pair scores silently wrong, it does not error.
# This one is a RobustScaler pickled by scikit-learn 1.9.0; pin >=1.9.0.
XGB_MODEL_PATH=data/artifacts/risk/risk-xgb.ubj
FEATURE_SCALER_PATH=data/artifacts/risk/feature_scaler.joblib
LANDSLIDE_SPLIT_DIR=data/processed/landslide
RISK_FLAG_THRESHOLD=0.85

# Terrain is 27 rasters (9 regions x dem/slope/aspect), not one file. ML-02
# opens them all as lazy rasterio handles and dispatches a sample by bounds.
TERRAIN_RASTER_DIR=data/raw/terrain

# KDTrees are built in DEGREES (EPSG:4326) but the model's distance features
# are in METRES — the serving path must convert exactly as training did.
INDEX_DIR=data/processed/indices
RIVER_KDTREE_PATH=data/processed/indices/river_waterways_spatial_index.pkl
BRIDGE_KDTREE_PATH=data/processed/indices/bridges_spatial_index.pkl
PINCH_KDTREE_PATH=data/processed/indices/hazard_pinch_points_spatial_index.pkl

# ---------- Geo ingest (DB-02) ----------
# road_network is MultiLineString/GeometryCollection with no topology columns:
# ST_Dump on ingest, then pgr_createTopology. See MANIFEST.yml.
ROAD_NETWORK_PARQUET=data/raw/geo/road_network.parquet
BRIDGES_PARQUET=data/raw/geo/bridges.parquet
DISTRICTS_PARQUET=data/raw/geo/districts.parquet
LANDSLIDE_EVENTS_PARQUET=data/raw/geo/landslide_events.parquet
RIVER_WATERWAYS_PARQUET=data/raw/hydrology/river_waterways.parquet
BLOCKED_EDGE_COST=999999

# ---------- Edge engine (MOB-05) ----------
# BLOCKED: the IO-VNBD tree on disk is Git LFS pointer stubs, not data.
#   git lfs install && git clone https://github.com/onyekpeu/IO-VNBD
IO_VNBD_DIR=data/raw/imu/IO-VNBD
TFLITE_MODEL_PATH=data/artifacts/edge/velocity-cnn.tflite

# ---------- External APIs ----------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ---------- Dashboard (Vite: must be VITE_ prefixed) ----------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
