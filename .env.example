# ---------- Shared ----------
NODE_ENV=development

# ---------- PostGIS ----------
# Host ports are 5433/6380, not the 5432/6379 defaults: another local stack
# (demo_radar) already binds those. Inside the containers the services still
# use their standard ports.
PGHOST=localhost
PGPORT=5433
PGDATABASE=drishti
PGUSER=drishti
PGPASSWORD=drishti
DATABASE_URL=postgresql://drishti:drishti@localhost:5433/drishti

# ---------- Redis / BullMQ ----------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
SYNC_QUEUE_NAME=burst-sync
SYNC_QUEUE_CONCURRENCY=4

# ---------- Backend ----------
PORT=4000
SOCKET_PATH=/socket.io
JWT_SECRET=change-me-in-production
TELEMETRY_HZ=1
AI_TIMEOUT_MS=30000

# How far from a road an incident report may be before it is refused. Beyond
# this it is a bad GPS fix, and blocking the "nearest" edge would close a road
# nobody reported.
INCIDENT_SNAP_MAX_M=200

# Whether a confident AI verdict may block a road with no human in the loop.
# MUST stay 0 (R9, Q2): the vision model has no "no incident" class and was
# trained on satellite/aerial imagery while drivers send ground-level photos.
# Reports land in incidents.status = 'pending_dispatcher_approval' and only a
# dispatcher action in WEB-05 promotes them to 'verified', which is the only
# status routable_edges honours.
AUTO_BLOCK_ON_AI_VERDICT=0

# ---------- AI services (FastAPI) ----------
# Paths are relative to the repo root and must match data/MANIFEST.yml.
# Run `python3 scripts/check_data.py` to see which of these exist locally.
AI_SERVICE_URL=http://localhost:8000

# Vision — incident verification (ML-05/ML-06)
YOLO_WEIGHTS=data/artifacts/vision/incident-yolov8n.pt
YOLO_DATASET=data/raw/vision/incident-yolo
# Must exceed 1/len(YOLO_CLASSES) or it can never reject: softmax top-1 over
# n classes is >= 1/n. The old 0.45 was inherited from the 4-class spec and
# became dead code at 2 classes (top-1 >= 0.5 always). Checked at startup.
YOLO_CONF_THRESHOLD=0.75
# CORRECTION (R8): TWO classes, not the dataset's four. NORMAL_TERRAIN and
# DAMAGED_BRIDGE_INFRASTRUCTURE are assigned by filename index arithmetic
# (landslide idx%4==0, flood idx%12==0 — verified 1380/1380), not by image
# content, so a model trained to emit them emits noise. Mapping to
# incidents.kind is BY NAME, never by index: ImageFolder orders classes
# alphabetically, which differs from data.yaml's order.
YOLO_CLASSES=FLOODED_ROAD_OR_SUBMERGED,ACTIVE_LANDSLIDE_DEBRIS
# Keep at 1 until the vision training data is replaced. The model has no
# "no incident" class, and it was trained on aerial/satellite imagery while
# the endpoint receives ground-level driver photos. API-03 must not set an
# edge cost to 999999 on a verdict carrying requires_human_review.
INCIDENT_REQUIRE_REVIEW=1

# Which window the rainfall features describe: 'forecast' (next N hours,
# what §5's pre-emptive rerouting needs) or 'antecedent' (previous N hours,
# what physically triggers a landslide). Both come back in one API call.
RAINFALL_WINDOW=forecast

# Landslide risk (ML-02/ML-04). The scaler must be the one fitted alongside
# the model — a mismatched pair scores silently wrong, it does not error.
# This one is a RobustScaler pickled by scikit-learn 1.9.0; pin >=1.9.0.
# Written by scripts/train_hazard_xgb.py. JSON, not .ubj: the sidecar
# hazard_model_meta.json beside it carries the feature and class order, and a
# text model that diffs in review is worth more than the binary's few KB.
XGB_MODEL_PATH=data/artifacts/risk/hazard_model.json
FEATURE_SCALER_PATH=data/artifacts/risk/feature_scaler.joblib
LANDSLIDE_SPLIT_DIR=data/processed/landslide
RISK_FLAG_THRESHOLD=0.85

# Terrain is 27 rasters (9 regions x dem/slope/aspect), not one file. ML-02
# opens them all as lazy rasterio handles and dispatches a sample by bounds.
TERRAIN_RASTER_DIR=data/raw/terrain

# CORRECTION (R7): the KDTrees are NOT in degrees. Their `.data` holds
# projected metres — x = lon * 111139 * cos(25.5°), y = lat * 111139 — an
# equirectangular projection about the NER centre latitude, recovered by
# least-squares from each index's own lat/lon and exact to ~1e-9 m.
# Querying one with a raw (lon, lat) pair does not error; it returns a
# confident neighbour hundreds of km away. drishti_ai.geo owns the transform
# and re-verifies it at startup. Distances are always reported by haversine
# against the neighbour's true lat/lon, never by scaling the tree's own
# Euclidean distance.
INDEX_DIR=data/processed/indices
RIVER_KDTREE_PATH=data/processed/indices/river_waterways_spatial_index.pkl
BRIDGE_KDTREE_PATH=data/processed/indices/bridges_spatial_index.pkl
PINCH_KDTREE_PATH=data/processed/indices/hazard_pinch_points_spatial_index.pkl
# Did not ship with the other three, but dist_to_road_m is one of the model's
# eight features. Built by scripts/build_road_index.py.
ROAD_KDTREE_PATH=data/processed/indices/road_network_spatial_index.pkl
# The pinch-point index is 133 MB of per-vertex dicts and neither endpoint
# needs it. Set to 1 when the dashboard overlay is wired up.
LOAD_PINCH_INDEX=0

# Open-Meteo caching. 0.1° ≈ 11 km, which is Open-Meteo's own grid spacing,
# so a shared cache entry would have returned the same upstream answer.
WEATHER_CACHE_PRECISION=1
WEATHER_CACHE_TTL_S=900
OPEN_METEO_TIMEOUT_S=10

# ---------- Geo ingest (DB-02) ----------
# road_network is MultiLineString/GeometryCollection with no topology columns:
# ST_Dump on ingest, then pgr_createTopology. See MANIFEST.yml.
ROAD_NETWORK_PARQUET=data/raw/geo/road_network.parquet
BRIDGES_PARQUET=data/raw/geo/bridges.parquet
DISTRICTS_PARQUET=data/raw/geo/districts.parquet
LANDSLIDE_EVENTS_PARQUET=data/raw/geo/landslide_events.parquet
RIVER_WATERWAYS_PARQUET=data/raw/hydrology/river_waterways.parquet
BLOCKED_EDGE_COST=999999

# ---------- Edge engine (MOB-05) ----------
# BLOCKED: the IO-VNBD tree on disk is Git LFS pointer stubs, not data.
#   git lfs install && git clone https://github.com/onyekpeu/IO-VNBD
IO_VNBD_DIR=data/raw/imu/IO-VNBD
# Actual filename written by scripts/train_idr_speed.py (R6).
TFLITE_MODEL_PATH=data/artifacts/edge/speed_model.tflite

# ---------- External APIs ----------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ---------- Dashboard (Vite: must be VITE_ prefixed) ----------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
