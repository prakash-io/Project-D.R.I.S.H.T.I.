<!-- Notification small icon.

     A dedicated monochrome vector, not the launcher mipmap: from API 21 the
     status bar masks the small icon to its alpha channel, so a full-colour
     ic_launcher renders as a featureless white square. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
  <!-- Location pin over a road: the app is tracking a vehicle's position. -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13C19,5.13 15.87,2 12,2zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5 2.5,1.12 2.5,2.5 -1.12,2.5 -2.5,2.5z"/>
</vector>
